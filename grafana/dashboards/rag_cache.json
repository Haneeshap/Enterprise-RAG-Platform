    {"type": "graph", "title": "Cache Latency", "datasource": "Prometheus", "targets": [{"expr": "cache_latency_seconds_bucket"}]},
    {"type": "stat", "title": "Docs Cached", "datasource": "Prometheus", "targets": [{"expr": "doc_cached_count"}]})
  ]
